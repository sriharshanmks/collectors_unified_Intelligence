# =============================================================================
# FIMMS — Collector's Unified Application
# Environment Configuration
# Copy this file to .env and fill in your credentials.
# =============================================================================

# ── Database (leave blank for SQLite dev mode, or set PostgreSQL URL)
DATABASE_URL=postgresql://fimms_user:fimms_password_2026@localhost:5432/fimms

# ── JWT Secret Key (change in production!)
SECRET_KEY=fimms-collector-super-secret-key-change-in-production-2026

# ─────────────────────────────────────────────────────────────────────────────
# LLM PROVIDER CONFIGURATION
# Set to "gemini" (default) or "bedrock" to switch.
# You can also switch live via the AI Triage panel in the FIMMS dashboard.
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini

# ── Google Gemini API (Used for RAG, deduplication & embeddings by default)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── AWS Bedrock (Optional – switch to bedrock when needed)
# Comment out GEMINI_API_KEY and set LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── News API (Optional – enables live news wire ingestion)
# Get your key at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ── S3 (Optional – for photo evidence uploads in production)
S3_BUCKET_NAME=fimms-uploads
S3_REGION=ap-south-1
